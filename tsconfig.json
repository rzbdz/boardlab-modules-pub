{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "boardlab": [
        "../better-boardlab/core/src/sdk.ts"
      ]
    }
  },
  "include": [
    "*/module.ts",
    "*/module.js"
  ]
}
