{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "boardlab": [
        "../better-boardlab/core/src/sdk.ts"
      ],
      "boardlab/client": [
        "../better-boardlab/core/src/shared/client.ts"
      ],
      "boardlab/ui": [
        "../better-boardlab/src/sdk.browser.ts"
      ],
      "boardlab-core/*": [
        "../better-boardlab/core/src/*"
      ]
    }
  },
  "include": [
    "*/**/*.ts"
  ]
}
